{
  "name": "genclarus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "vitest run --config scripts/validation/vitest.config.ts",
    "measure:grounding": "vitest run --config scripts/validation/grounding.config.ts",
    "warm": "node scripts/warm-cache.mjs",
    "corpus:generate": "node --env-file=.env.local --import tsx scripts/corpus/generate.ts"
  },
  "dependencies": {
    "3dmol": "^2.5.5",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^7",
    "vitest": "^4.1.10"
  }
}
